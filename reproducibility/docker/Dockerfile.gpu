# gpu image: nvidia/cuda:13.0.1-runtime-ubuntu24.04 + torch (cu130) +
# transformers + accelerate, for S8 (CUDA probes) and S9 (LLM / Qwen2.5-
# 0.5B-Instruct).
#
# CUDA 13 is required, not CUDA 12 (Task 12 resolution 3, verified on
# hardware): dgxspark's GB10 is compute capability (12, 1), which a cu12
# torch build cannot target at all. All three GPU hosts (anakin, blade,
# dgxspark) run driver 580.x / CUDA 13.0, so this single image covers all
# three.
#
# Built from this development host only as far as wheel-availability
# checks (an aarch64 MacBook with no GPU reachable from containers, per
# Task 12 instructions); built and run for real on anakin's RTX 4090
# (fix round 1, by the task coordinator, not from here). Confirmed there:
# the build succeeds, torch.cuda.is_available() is True, `python -m
# reprobench.runner --probes S7,S8` completes and writes a well-formed
# results JSON (all ten probes recorded, ~2.2s wall time), and the env
# block correctly carries the torch/CUDA/cuDNN versions, both TF32 flags,
# the GPU name/SM count, and CUBLAS_WORKSPACE_CONFIG. The extra-index-url
# pattern below and the venv-under-PEP-668 handling both held up under
# that run. One gap found and fixed in that same round: pytest was
# missing from requirements/gpu.txt, which made the one image where the
# GPU-only probes (S8/S9) can actually be exercised unable to run its own
# smoke test before spending a measurement slot.
FROM nvidia/cuda:13.0.1-runtime-ubuntu24.04

ENV REPRO_IMAGE=gpu
ENV PYTHONPATH=/work
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /work

# Ubuntu 24.04 ships Python 3.12 by default (confirmed via `apt-cache
# policy python3`, Task 12) and enforces PEP 668 (externally-managed
# environment), so pip installs go into a venv rather than system site-
# packages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

# torch is installed from the official CUDA 13 wheel index (as an EXTRA
# index, not exclusive) with the "+cu130" local version pinned explicitly
# -- the same pattern used in Dockerfile.base/py313/oldpy for the CPU
# wheel index, and for the same reason: an exclusive --index-url was
# found (Task 12, on the CPU index, cp310 specifically) to fail on a
# metadata Name-normalization mismatch for a plain dependency
# (typing_extensions) that forces an sdist build needing `flit_core`,
# unavailable on PyTorch's restricted indexes. Using an extra index with
# the version's local suffix pinned avoids that failure mode by letting
# pip still resolve torch's own dependencies from default PyPI. This
# specific combination (cu130, cp312) was not itself exercised (no GPU
# host reachable from here); the safer pattern is applied proactively
# given the known failure mode on a sibling index. The default PyPI
# "torch" wheel is CUDA 12-based and cannot target GB10's compute
# capability (12, 1) at all (resolution 3). Verified (Task 12):
# torch==2.14.1+cu130 has a cp312 wheel on both linux/amd64 and
# linux/aarch64 via this index.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cu130 torch==2.14.1+cu130

COPY requirements/gpu.txt ./requirements/gpu.txt
RUN pip install --no-cache-dir -r requirements/gpu.txt

COPY reprobench/ ./reprobench/
COPY tests/ ./tests/
