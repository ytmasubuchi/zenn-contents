# "base" / "new" image used by E1, E2, E3, E6, and E5 (built for both
# linux/amd64 and linux/arm64), and reused as the "new" side of E4.
#
# Versions are pinned exactly (no ranges) so results are attributable to a
# single, known library stack.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    numpy==2.1.3 \
    scipy==1.14.1 \
    scikit-learn==1.5.2 \
    threadpoolctl==3.5.0 \
    --index-url https://pypi.org/simple

RUN pip install --no-cache-dir \
    torch==2.5.1 \
    --index-url https://download.pytorch.org/whl/cpu

WORKDIR /work
